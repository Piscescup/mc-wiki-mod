{
	"schemaVersion": 1,
	"id": "mc-wiki",
	"version": "${version}",
	"name": "Minecraft Wiki Mod",
	"description": "Searches the Minecraft Wiki and shows the results inside an in-game browser screen.",
	"authors": [
		"REN YuanTong"
	],
	"contact": {
		"homepage": "https://minecraft.wiki"
	},
	"license": "LGPL-2.1-only",
	"icon": "assets/mc-wiki/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"io.github.piscescup.mcwiki.MinecraftWikiMod"
		],
		"client": [
          "io.github.piscescup.mcwiki.MinecraftWikiModClient"
		],
		"fabric-datagen": [
			"io.github.piscescup.mcwiki.MinecraftWikiModDataGenerator"
		],
		"modmenu": [
			"io.github.piscescup.mcwiki.modmenu.MCWikiModMenuImpl"
		]
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/jEGF5fb"
			},
			"badges": [ "library", "deprecated" ],
			"parent": {
				"id": "mc-wiki",
				"name": "Minecraft Wiki",
				"description": "Searches the Minecraft Wiki and shows the results inside an in-game browser screen.",
				"icon": "assets/mc-wiki/icon.png",
				"badges": [ "library" ]
			},
			"update_checker": true
		}
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"mcef-modern": "*"
	}
}
